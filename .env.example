# ==============================================================================
# SignBridge Universal — Production Environment Configuration
# Copy this file to .env before starting containers: `cp .env.example .env`
# ==============================================================================

# Core System
PROJECT_NAME="SignBridge Universal API"
VERSION="1.0.0"
ENVIRONMENT="production"

# AI & Multimodal Intelligence
# Get your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""

# Security & CORS (Comma-separated origins for production hospital domain)
ALLOWED_ORIGINS="http://localhost,http://127.0.0.1,https://signbridge.hospital.gov.in"

# Port Bindings
BACKEND_PORT=8000
FRONTEND_PORT=80

# SQLite / Database Concurrency
DATABASE_URL="sqlite:////app/data/signbridge.db"
